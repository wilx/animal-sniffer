<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>localdomain.localhost</groupId>
  <artifactId>kotlin-inline</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kotlin.version>2.3.20</kotlin.version>
    <!-- Each invoker run cleans its artifacts; do not reuse a compiler daemon across runs. -->
    <kotlin.compiler.daemon>false</kotlin.compiler.daemon>
    <case>positive-23</case>
    <extraSources>${project.basedir}/src/positive/kotlin</extraSources>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
    <dependency>
      <groupId>org.codehaus.mojo</groupId>
      <artifactId>animal-sniffer-annotations</artifactId>
      <version>@project.version@</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${project.basedir}/target/${case}</directory>
    <sourceDirectory>src/positive/kotlin</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>compile</id>
            <phase>compile</phase>
            <goals><goal>compile</goal></goals>
          </execution>
        </executions>
        <configuration>
          <jdkHome>${java.home}</jdkHome>
          <jvmTarget>1.8</jvmTarget>
          <sourceDirs>
            <sourceDir>${project.basedir}/src/positive/kotlin</sourceDir>
            <sourceDir>${extraSources}</sourceDir>
          </sourceDirs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>@project.groupId@</groupId>
        <artifactId>@project.artifactId@</artifactId>
        <version>@project.version@</version>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <signature>
                <groupId>org.codehaus.mojo.signature</groupId>
                <artifactId>java18</artifactId>
                <version>1.0</version>
              </signature>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>negative</id>
      <properties>
        <extraSources>${project.basedir}/src/negative/kotlin</extraSources>
      </properties>
    </profile>
    <profile>
      <id>scopes</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-maven-plugin</artifactId>
            <configuration>
              <args><arg>-Xuse-inline-scopes-numbers</arg></args>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
